{
  "name": "@applytrack/web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "typecheck": "vue-tsc --build",
    "test": "vitest run",
    "e2e": "cross-env PLAYWRIGHT_BROWSERS_PATH=0 playwright test --project=mobile-360 --project=tablet-768 --project=desktop-1280 --project=wide-1920",
    "e2e:ui": "cross-env PLAYWRIGHT_BROWSERS_PATH=0 playwright test --ui",
    "screenshots": "cross-env PLAYWRIGHT_BROWSERS_PATH=0 playwright test --project=screenshots",
    "e2e:install": "cross-env PLAYWRIGHT_BROWSERS_PATH=0 playwright install chromium",
    "screenshots:readme": "cross-env PLAYWRIGHT_BROWSERS_PATH=0 README_SCREENSHOTS=1 playwright test --project=screenshots",
    "size": "node scripts/check-bundle-size.mjs",
    "lighthouse": "cross-env PLAYWRIGHT_BROWSERS_PATH=0 node scripts/lighthouse.mjs"
  },
  "dependencies": {
    "@applytrack/adapter-local": "workspace:*",
    "@applytrack/adapter-supabase": "workspace:*",
    "@applytrack/composition": "workspace:*",
    "@applytrack/i18n": "workspace:*",
    "@applytrack/notifications": "workspace:*",
    "@applytrack/presentation": "workspace:*",
    "@supabase/supabase-js": "^2.117.2",
    "intl-messageformat": "^12.1.2",
    "vue": "^3.5.43",
    "vue-i18n": "^11.4.13",
    "vue-router": "^5.3.1"
  },
  "devDependencies": {
    "@applytrack/config": "workspace:*",
    "@applytrack/core": "workspace:*",
    "@axe-core/playwright": "^4.13.0",
    "@intlify/eslint-plugin-vue-i18n": "^4.5.1",
    "@playwright/test": "^1.64.0",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@testing-library/vue": "^8.1.0",
    "@types/node": "^26.6.4",
    "@vitejs/plugin-vue": "^6.0.9",
    "cross-env": "^10.1.0",
    "eslint-plugin-vue": "^10.11.1",
    "globals": "^17.13.0",
    "jsdom": "^30.1.2",
    "lighthouse": "^13.5.0",
    "playwright": "^1.64.0",
    "tailwindcss": "^4.3.3",
    "typescript-eslint": "^8.71.0",
    "vite": "^8.3.2",
    "vitest": "^5.0.3",
    "vue-eslint-parser": "^10.4.1",
    "vue-tsc": "^3.3.12"
  }
}
