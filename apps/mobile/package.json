{
  "name": "@applytrack/mobile",
  "version": "0.0.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "start:tunnel": "expo start --tunnel",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "doctor": "npx expo-doctor@latest",
    "test": "jest",
    "e2e:mobile": "maestro test -e APP_URL=exp://10.0.2.2:8081 .maestro/flows",
    "screenshots:mobile": "maestro test -e APP_URL=exp://10.0.2.2:8081 --test-output-dir .maestro-output .maestro/screenshots && node scripts/copy-screenshots.mjs"
  },
  "dependencies": {
    "@applytrack/adapter-local": "workspace:*",
    "@applytrack/adapter-supabase": "workspace:*",
    "@applytrack/composition": "workspace:*",
    "@applytrack/core": "workspace:*",
    "@applytrack/design-tokens": "workspace:*",
    "@applytrack/i18n": "workspace:*",
    "@applytrack/notifications": "workspace:*",
    "@applytrack/presentation": "workspace:*",
    "@expo-google-fonts/inter": "^0.4.2",
    "@formatjs/intl-getcanonicallocales": "^3.2.12",
    "@formatjs/intl-locale": "^5.3.12",
    "@formatjs/intl-pluralrules": "^6.3.15",
    "@formatjs/intl-relativetimeformat": "^12.3.15",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/datetimepicker": "9.1.0",
    "@supabase/supabase-js": "^2.117.2",
    "expo": "~57.0.27",
    "expo-constants": "~57.0.21",
    "expo-crypto": "~57.0.3",
    "expo-font": "~57.0.4",
    "expo-linking": "~57.0.12",
    "expo-localization": "~57.0.2",
    "expo-router": "~57.0.25",
    "expo-splash-screen": "~57.0.9",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.4",
    "i18next": "^26.4.2",
    "i18next-icu": "^2.5.0",
    "intl-messageformat": "^12.1.3",
    "nativewind": "^4.2.7",
    "react": "19.2.3",
    "react-i18next": "^17.0.16",
    "react-native": "0.86.3",
    "react-native-css-interop": "0.2.7",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.2",
    "react-native-svg": "15.15.4",
    "react-native-url-polyfill": "^4.0.0",
    "react-native-worklets": "0.10.1"
  },
  "devDependencies": {
    "@applytrack/config": "workspace:*",
    "@expo/ngrok": "^4.1.3",
    "@testing-library/react-native": "^14.0.1",
    "@types/jest": "29.5.14",
    "@types/react": "~19.2.2",
    "eslint-plugin-i18next": "^6.1.5",
    "expo-doctor": "^1.20.4",
    "jest": "~29.7.0",
    "jest-expo": "~57.0.5",
    "tailwindcss": "^3.4.19",
    "test-renderer": "^1.3.0",
    "typescript": "~6.0.3"
  },
  "jest": {
    "preset": "jest-expo",
    "setupFiles": [
      "./jest.setup.js"
    ],
    "transformIgnorePatterns": [
      "node_modules/(?!(.pnpm|(jest-)?react-native|@react-native(-community)?|expo(nent)?|@expo(nent)?/.*|expo-router|react-navigation|@react-navigation/.*|react-native-svg|nativewind|react-native-css-interop|intl-messageformat|@formatjs/.*|i18next-icu|i18next|react-i18next|standard-navigation|@formatjs/.*))"
    ]
  }
}
